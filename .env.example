ENABLE_COMFYUI=true
ENABLE_QWEN=true
JUPYTER_TOKEN=
# Copy to .env for local Docker use. Set a random secret of at least 32 characters.
LLAMA_API_KEY=
CTX_SIZE=65536

# Optional read token for Hugging Face. Public model works without it.
HF_TOKEN=

# true: browser chat + API; false: API only
ENABLE_WEBUI=true
# Required when ENABLE_WEBUI=true. Use your own email and a unique 16-72 character ASCII password.
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# Civitai download token (kept outside Git)
CIVITAI_TOKEN=
REQUIRE_MINIMAX_DOWNLOADS=true
PERSIST_MODELS_TO_VOLUME=false
